APP_ENV=development
APP_NAME=فمونا سنس
LOG_LEVEL=INFO
STARTUP_VALIDATE=1

BOT_TOKEN=
BOT_USERNAME=
ADMIN_USER_ID=
ADMIN_API_TOKEN=

DATABASE_URL=postgresql+psycopg://cinema_vault:CHANGE_ME@localhost:5432/cinema_vault
# لاگ کردن کوئری‌های SQLAlchemy در کنسول (فقط برای دیباگ؛ در Production 0 بماند)
DB_ECHO=0
REDIS_URL=redis://localhost:6379/0

PUBLIC_BASE_URL=https://example.com
ALLOWED_HOSTS=example.com
RATE_LIMIT_ENABLED=0
RATE_LIMIT_FAIL_CLOSED=0

TELEGRAM_MODE=polling
# Optional proxy for Telegram traffic (fixes getaddrinfo/blocked api.telegram.org):
# Examples: socks5://127.0.0.1:10808  or  http://127.0.0.1:10809
TELEGRAM_PROXY_URL=
TELEGRAM_WEBHOOK_SECRET=
RUN_MAINTENANCE_IN_BOT=1
RUN_NOTIFICATIONS_IN_BOT=1

MAIN_CHANNEL_ID=
MAIN_CHANNEL_USERNAME=
PRODUCTION_STORAGE_CHAT_ID=
TEST_STORAGE_CHAT_ID=
TELEGRAM_STORAGE_CHAT_ID=
TELEGRAM_STORAGE_REQUIRED=1
TELEGRAM_BOT_API_BASE_URL=https://api.telegram.org
# [FIX-E] ریشه‌ی فایل‌های Bot API «سرور محلی» — فقط وقتی معنا دارد که
# TELEGRAM_BOT_API_BASE_URL به یک telegram-bot-api محلی اشاره کند (برداشتن سقف
# ۲۰MB دانلود/کپی مستقیم فایل). خالی = پیش‌فرض کد (/var/lib/telegram-bot-api).
TELEGRAM_LOCAL_FILE_ROOT=

CONTENT_RIGHTS_REQUIRED=1
CONTENT_RIGHTS_ACK=

MEDIA_UPSTREAM_ALLOWLIST=
MEDIA_ALLOW_ANY_HTTPS=0

WINAPAY_MERCHANT_ID=
WINAPAY_SANDBOX=1
WINAPAY_BASE_URL=https://winapay.io/webservice/rest

FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
# ریشه‌ی پوشه‌ی کار Media Worker (مسیر لینوکسی با اسلش رو به جلو؛ در ویندوز هم مسیر نسبی درست resolve می‌شود)
MEDIA_WORK_ROOT=./media_work
MEDIA_WORKER_ID=media-worker-1
MEDIA_WORKER_CONCURRENCY=1
MEDIA_JOB_LEASE_SECONDS=900
MEDIA_JOB_HEARTBEAT_SECONDS=30
MEDIA_JOB_POLL_SECONDS=1
MEDIA_MAX_JOB_ATTEMPTS=3
MEDIA_CLEANUP_TEMP=1
# کش مشترک فایل منبع: هر سهٔ کیفیت (۱۰۸۰/۷۲۰/۴۸۰) منبع را فقط یک‌بار دانلود می‌کنند
# و تلاش‌های مجدد هم از کش استفاده می‌کنند (0 = غیرفعال)
MEDIA_SOURCE_CACHE=1
MEDIA_X264_PRESET=medium
MEDIA_AUDIO_BITRATE=128k
# سقف زمانی هر فرایند ffmpeg بر حسب ثانیه (پیش‌فرض 21600 = 6 ساعت)
MEDIA_FFMPEG_TIMEOUT_SECONDS=21600

NOTIFICATION_WORKER_ID=notification-worker-1
MAINTENANCE_INTERVAL_SECONDS=15
# شناسه‌ی پایدار برای Heartbeat؛ اگر خالی باشد از «hostname:service» استفاده می‌شود (پایدار در ری‌استارت‌ها)
SERVICE_INSTANCE_ID=
# پوشه‌ی پیکربندی‌های JSON اجرایی (پنل ادمین آن‌ها را می‌نویسد): payment_gateway.json و ...
CINEMAVAULT_RUNTIME_DIR=
AUDIT_RETENTION_DAYS=180
MEDIA_EVENT_RETENTION_DAYS=90

# ---------- Growth / Operation extras ----------
# سهمیه دانلود روزانه کاربران بدون اشتراک (0 = دانلود رایگان برای غیرمشترک‌ها «غیرفعال»، نه نامحدود)
FREE_DAILY_DOWNLOAD_LIMIT=5
# [TTL-DL] اعتبار دکمه‌های دانلود (ثانیه)؛ 0 = بدون انقضا — مقدار پیش‌فرض؛ ادمین می‌تواند از پنل (تنظیمات سامانه) تغییرش دهد
DOWNLOAD_LINK_TTL_SECONDS=60
# پاداش کیف پولی معرف به‌ازای هر دعوت موفق (ریال)
REFERRAL_REWARD_IRR=100000
# کد تخفیف بازگشت (وین‌بک) — اگر در پنل «کدهای تخفیف» با همین کد بسازید در پیام وین‌بک نمایش داده می‌شود
WINBACK_COUPON_CODE=
# بک‌آپ خودکار روزانه pg_dump و ارسال به کانال (روی سرور باید pg_dump نصب باشد)
AUTO_BACKUP_ENABLED=0
AUTO_BACKUP_CHAT_ID=
AUTO_BACKUP_HOUR=3
